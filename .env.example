# URL de conexión a la base de datos PostgreSQL.
# En desarrollo y producción se completa con la URL real de Neon.
DATABASE_URL=

# Puerto donde corre el backend localmente.
PORT=3000

# URL del frontend autorizado por CORS.
# En desarrollo, Vite usa normalmente http://localhost:5173.
# En producción, reemplazar por la URL del frontend desplegado.
FRONTEND_URL=http://localhost:5173