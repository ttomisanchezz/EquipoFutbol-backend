generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id               Int      @id @default(autoincrement())
  name             String
  category         String
  shortDescription String
  description      String
  country          String
  league           String
  stadium          String
  founded          Int
  coach            String
  titles           Int
  logoUrl          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
